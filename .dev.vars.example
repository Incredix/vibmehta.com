ADMIN_PASSWORD=local-admin
# Street addresses stay out of git. Set one per listing id.
LISTING_FREMONT_ADDRESS=
# Optional. The private room uses the Fremont address unless this is set.
# LISTING_FREMONT_ROOM_ADDRESS=
# Live credit (optional). Without these, Run Credit returns a clearly labeled demo score.
# CREDIT_PROVIDER=microbilt
# MICROBILT_CLIENT_ID=
# MICROBILT_CLIENT_SECRET=
# MICROBILT_SANDBOX=true
# CREDIT_API_URL=
# CREDIT_API_KEY=
# CRS_API_KEY=
# CRS_CONFIG=

# Email via TCP SES (no AWS keys on Cloudflare). Set secret in CF Worker secrets.
# TCP_EMAIL_INGEST_URL=https://tradechefpro.com/api/external/vibmehta-email/
# TCP_EMAIL_INGEST_SECRET=
